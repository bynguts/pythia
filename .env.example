# Pythia environment configuration (copy to .env; never commit real secrets)

# CORS: comma-separated list of allowed frontend origins
PYTHIA_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Shared role logins (username = role name). Demo defaults are "<role>-demo-pass";
# an empty value below counts as unset (the default applies). Override each role
# in real deployments:
PYTHIA_PW_EXECUTIVE=
PYTHIA_PW_DISPATCHER=
PYTHIA_PW_SUPERVISOR=
PYTHIA_PW_DRIVER=
PYTHIA_PW_AUDITOR=
PYTHIA_PW_ADMINISTRATOR=

# Personal accounts (optional). A JSON file of users, each with username, a PBKDF2
# password_hash (`python -m app.core.auth hash <password>` from apps/api), role, and
# optionally truck_code (binds a driver to one truck) and display_name. Template:
# apps/api/users.example.json (placeholders only). The real users.json is git-ignored.
# The audit trail then records each person's username instead of a shared role.
# A relative path resolves against apps/api.
# PYTHIA_USERS_FILE=users.json

# OpenWA WhatsApp gateway (leave blank to keep alerts honestly unsent)
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# OpenAI for the assistant (optional; falls back to local responder)
OPENAI_API_KEY=

# GutsAI vision for driver weighbridge receipt OCR (manual entry if unset)
GUTS_API_KEY=
GUTS_BASE_URL=https://api.gutsai.id/v1
GUTS_VISION_MODEL=gemini-3.8-flash

# Background AI engine (auto-reroute, TPA queue predictor, event forecast).
# The Windows launchers set this to "on"; without it every /api/ai/* endpoint
# returns empty. Set to "on" for demos, "off" keeps tests deterministic.
PYTHIA_AI_ENGINE=on

# --- Optional (defaults shown) -------------------------------------------
# OpenAI-compatible gateway and model for the assistant
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4.1-mini
# Default WhatsApp recipients when apps/api/driver_contacts.json has none
# (placeholders 6281234567890@c.us / 6281234567890-1620000000@g.us otherwise)
# driver_contacts.json "drivers" keys must be the fleet's driver names, e.g.
# "Pengemudi Sim 01"; an unmatched name goes to the default chat and is logged once
# PYTHIA_WA_DEFAULT_CHAT_ID=
# PYTHIA_WA_DEFAULT_GROUP_ID=
# WhatsApp send timeout in seconds
# OPENWA_TIMEOUT_SECONDS=3
# SQLite history/SPJ/plan stores (default: <system temp>/pythia_history.db)
# PYTHIA_DB_PATH=
# Dataset root (default: ml/data in the repo; /data in the docker image)
# PYTHIA_DATA_DIR=
# Seed demo SPJ work orders into an empty store (on | off)
# PYTHIA_SPJ_SEED=on
# Allow straight-line SPJ paths when OSRM is unreachable (on | off)
# PYTHIA_SPJ_STRAIGHT_FALLBACK=off
# GPS source for the AI engine (simulated | live)
# PYTHIA_GPS_SOURCE=simulated
# Recording determinism. Pin the forecast "today" (twin, fleet, forecast) to one date,
# and serve a saved Open-Meteo response instead of fetching (the twin labels it
# "forecast snapshot fetched at ..."). Save one with
# `python -m app.forecast.weather save [path]` from apps/api
# (default apps/api/data/weather_snapshot.json), then pin the demo date to its first day.
# PYTHIA_DEMO_DATE=2026-10-24
# A relative snapshot path resolves against apps/api.
# PYTHIA_WEATHER_SNAPSHOT=data/weather_snapshot.json
# Extra host suffixes `vite preview` accepts besides the phone-demo tunnels
# (.trycloudflare.com, .loca.lt), comma-separated; read by apps/web/vite.config.js
# PYTHIA_TUNNEL_HOSTS=
# Build-time (apps/web): the address the Twin's "Put on the table" QR code points phones
# at, e.g. the laptop's LAN or Tailscale address. Defaults to the page's own origin.
# VITE_PUBLIC_ORIGIN=http://192.168.1.20:5175
# Driver safety: sweep observed gate waits every 60 s so a 3 h gate alert is stored
# (and sent to PYTHIA_WA_DEFAULT_GROUP_ID) even when no panel is open (on | off).
# PYTHIA_SAFETY_GATE_TIMER=on
