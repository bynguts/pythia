# Python cache / virtualenv
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Node / Vite dependency and build cache
node_modules/
dist/
dist-*/
recordings/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Runtime SQLite stores (history, SPJ, permits, pretrip, damage, service,
# operations) with their -wal/-shm/-journal files, plus old import markers.
pythia_*.db*
*.db-journal
*.json.migrated

# --- Secrets & runtime artifacts (MUST NOT be committed) ---

# Environment files with real credentials
.env
.env.*
!.env.example

# Backend boot / smoke logs
*.log

# WhatsApp (Baileys) session credentials — regenerated at runtime via QR scan.
# Unanchored: the gateway writes it relative to the directory it is started from.
**/baileys_auth_info/
# Browser-automation cache from the old WhatsApp client library
**/.node-persist/
# Real driver WhatsApp numbers (template: apps/api/driver_contacts.example.json)
driver_contacts.json

# --- Internal working documents (not part of the shipped product) ---
# Competition, audit and pilot material stays local; the assistant's corpus
# lives in apps/api/knowledge/.
/docs/
**/.superpowers/

# Training backups (ml/scripts write the previous models here) and scrape outputs
**/_synthetic_backup/
ml/data/raw/*.txt

# Local design-tool state
.impeccable/

# Playwright artifacts
test-results/
playwright-report/

# Local audit screenshots
audit_*.png
audit2_*.png
audit3_*.png
final_*.png
verify_*.png

map_verify.png

# Python packaging, editors, local overrides
*.egg-info/
build/
*.local
.idea/
.vscode/

# Local tool state and agent instruction files (kept on each machine, not published)
.omc/
.codegraph/
.claude/
CLAUDE.md
AGENTS.md
DESIGN.md
