# Python cache / virtualenv
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
*.egg-info/
build/

# Node / Vite dependency and build cache
node_modules/
dist/
dist-*/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright artifacts and local scratch specs
test-results/
playwright-report/
apps/web/e2e/_*.spec.js

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.local

# --- Secrets and runtime data (must never be committed) ---

# Environment files (template: .env.example)
.env
.env.*
!.env.example

# Logs
*.log

# Runtime SQLite stores with their -wal/-shm/-journal files
pythia_*.db*
*.db
*.db-journal
*.sqlite*

# WhatsApp (Baileys) session credentials, regenerated by a QR scan; unanchored
# because the gateway writes it relative to the directory it is started from
**/baileys_auth_info/
**/.node-persist/

# Real driver WhatsApp numbers (template: apps/api/driver_contacts.example.json)
driver_contacts.json
# Real personal accounts and password hashes (template: apps/api/users.example.json)
users.json
# Recorded demo-day weather (python -m app.forecast.weather save); local per demo
apps/api/data/weather_snapshot.json

# --- Local-only material ---

# Working documents; the assistant's corpus lives in apps/api/knowledge/
/docs/

# Demo media (licensed per machine, not redistributed)
apps/api/data/media/

# Previous models written by ml/scripts, and raw scrape outputs
**/_synthetic_backup/
ml/data/raw/*.txt

# Tool state and agent instruction files
.omc/
.codegraph/
.claude/
.impeccable/
CLAUDE.md
AGENTS.md
DESIGN.md

# Playwright MCP browser artefacts
.playwright-mcp/
