__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Node / Vite dependency and build cache
node_modules/
dist/
dist-*/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Runtime SQLite (regenerated at runtime)
pythia_history.db
*.db-journal
# Durable record stores (SPJ, permits, pretrip, damage, service) and the
# one-time legacy JSON import marker.
pythia_spj.db*
pythia_permits.db*
pythia_pretrip.db*
pythia_damage_reports.db*
pythia_service_history.db*
pythia_operations.db*
*.json.migrated
# Pre-rebrand store files (kept on disk after adoption as a rollback copy)
# and interrupted adoptions.
jwis_*.db*
*.db.adopting-*

# --- Secrets & runtime artifacts (MUST NOT be committed) ---

# Environment files with real credentials
.env
.env.*
!.env.example

# Backend boot / smoke logs
*.log

# WhatsApp (Baileys) session credentials — regenerated at runtime via QR scan
pythia/backend/wa-gateway/baileys_auth_info/

# The source tree moved from jwis/ to pythia/. Untracked files left behind in
# an existing checkout (.env, node_modules, the Baileys session above, *.db)
# stay local; move what you still need into pythia/.
/jwis/

# --- Internal working documents (not part of the shipped product) ---
**/.superpowers/
**/docs/superpowers/
COMPETITION_CHECKLIST_STATUS.md
jakarta_waste_ai_prd_v2.md

# Playwright artifacts
test-results/
playwright-report/

