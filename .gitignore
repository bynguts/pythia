# --- Secrets & runtime artifacts (MUST NOT be committed) ---

# Environment files with real credentials
.env
.env.*
!.env.example

# Backend boot / smoke logs
*.log

# WhatsApp (Baileys) session credentials — regenerated at runtime via QR scan
jwis/backend/wa-gateway/baileys_auth_info/

