# Pythia docker deploy settings. Copy to deploy/.env (git-ignored) and fill in.
# The full list of settings the code reads is in the repo's root .env.example.

# The public address users open, e.g. https://pythia.example.org. CORS must allow it.
PYTHIA_ALLOWED_ORIGINS=https://pythia.example.org

# Where the frontend listens on the host. 80 on a bare server; behind Caddy or another
# reverse proxy that owns 80/443, bind to loopback and proxy to it.
PYTHIA_HTTP_BIND=127.0.0.1:8080

# Role logins (username = role name). Set every one: the defaults are public.
PYTHIA_PW_EXECUTIVE=
PYTHIA_PW_DISPATCHER=
PYTHIA_PW_SUPERVISOR=
PYTHIA_PW_DRIVER=
PYTHIA_PW_AUDITOR=
PYTHIA_PW_ADMINISTRATOR=

# Background AI engine (auto-reroute, gate-queue predictor, event forecast).
PYTHIA_AI_ENGINE=on

# Assistant Ana and the weigh-ticket OCR, through an OpenAI-compatible gateway.
# Without a key Ana answers locally and says so, and the ticket is typed by hand.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Vision model for the ticket OCR (defaults to OPENAI_MODEL; it must accept images).
OPENAI_VISION_MODEL=

# WhatsApp: pair from Settings -> WhatsApp after the first start. Recipients:
# PYTHIA_WA_DEFAULT_CHAT_ID=6281234567890@c.us
# PYTHIA_WA_DEFAULT_GROUP_ID=6281234567890-1620000000@g.us

# Build-time (frontend): "Book a demo" target on the landing page.
# VITE_CONTACT_URL=mailto:team@example.org
